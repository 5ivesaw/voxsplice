  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default desktop capabilities for VoxSplice Studio and Quick-Type Overlay",
  "windows": ["main", "pill"],
  "permissions": [
    "core:default",
    "core:window:allow-set-always-on-top",
